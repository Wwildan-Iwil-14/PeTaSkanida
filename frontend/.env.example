# ===== Frontend PeTa SKANIDA =====

# Base path build. GitHub Pages: /Peta-Skanida/ ; Vercel/domain root: /
# Kosongkan untuk memakai default GitHub Pages.
VITE_BASE_PATH=/Peta-Skanida/

# Alamat backend REST API
VITE_API_BASE_URL=http://localhost:3001/api

# Supabase public (anon key) - hanya untuk real-time dashboard admin
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
