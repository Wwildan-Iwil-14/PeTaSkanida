# ===== Frontend PeTa SKANIDA =====

# Alamat backend REST API
# Development: gunakan /api (otomatis diteruskan proxy Vite ke backend).
# Deployment : ganti dengan URL backend lengkap, mis. https://api.domain.com/api
VITE_API_BASE_URL=/api

# Tujuan proxy Vite untuk /api (opsional, default http://localhost:3001)
# VITE_API_PROXY_TARGET=http://localhost:3001

# Supabase anon key TIDAK dipakai lagi di browser (data tamu tidak boleh
# dibaca publik). Koneksi database hanya lewat backend dengan service role key.

# Kontak customer service yang muncul di landing page
# Nomor WhatsApp pakai format internasional tanpa tanda + (contoh: 6281234567890)
VITE_CS_EMAIL=cs@petaskanida.sch.id
VITE_CS_WHATSAPP=6280000000000
# VITE_CS_WHATSAPP_MESSAGE=Halo, saya ingin bertanya tentang kunjungan di PeTa SKANIDA.
