# ===== Backend PeTa SKANIDA =====

# Port server API
PORT=3001

# URL project Supabase (Settings > API)
SUPABASE_URL=https://xxxxx.supabase.co

# Service role key (Settings > API Keys > service_role)
# WAJIB untuk approve/reject request karena operasi tulis melewati RLS.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anon key, hanya dipakai sebagai fallback ketika service role key belum diisi
SUPABASE_ANON_KEY=your_anon_key_here

# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173

# ===== Upload surat tugas =====
# Surat tugas tamu (PDF, maks. 4 MB) disimpan di bucket Supabase Storage
# "surat-tugas". Buat bucket sekali dengan: npm run storage:setup
# Tidak perlu kredensial Google: Supabase sudah memakai service role key di atas.
# Jalankan juga database/migrations/20261120000000_add_surat_tugas_columns.sql
# di Supabase SQL Editor agar tautan tersimpan di database.

# Email tujuan dokumen surat tugas (sementara: gmail pribadi).
# Nanti cukup ganti ke email sekolah di sini — tidak perlu ubah kode.
SURAT_TUGAS_EMAIL=rubikesper@gmail.com

# ===== Notifikasi browser (Web Push) =====
# VAPID adalah pasangan kunci yang mengidentikasi server pengirim notifikasi.
# Buat kuncinya dengan: npm run push:keys
# VAPID_PUBLIC_KEY  -> dipakai browser saat berlangganan (boleh dibagikan)
# VAPID_PRIVATE_KEY -> dipakai backend untuk menandatangani pesan (RAHASIA!)
# Jangan pernah memasukkan private key ke frontend atau commit ke Git.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@petaskanida.sch.id
# PUSH_FRONTEND_URL=http://localhost:5173

# CATATAN: AUTH_SECRET dan TOKEN_TTL_SECONDS tidak lagi dipakai.
# Login admin sekarang memakai Supabase Auth (GoTrue) — token & masa berlakunya
# diatur langsung oleh Supabase.
