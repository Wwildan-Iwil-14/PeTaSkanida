# ===== Backend PeTa SKANIDA =====

# Port server API
PORT=3001

# URL project Supabase (Settings > API)
SUPABASE_URL=https://xxxxx.supabase.co

# Service role key (Settings > API Keys > service_role)
# WAJIB untuk approve/reject request karena operasi tulis melewati RLS.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anon key, hanya dipakai sebagai fallback ketika service role key belum diisi
SUPABASE_ANON_KEY=your_anon_key_here

# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173

# ===== Google Drive (opsional) =====
# Untuk menyimpan surat tugas tamu (PDF, maks. 4 MB) ke folder
# "doc_kunjungan" pada akun rubikesper@gmail.com.
#
# Siapkan:
# 1. Buat service account di Google Cloud + aktifkan Google Drive API.
# 2. Share folder "doc_kunjungan" ke email service account sebagai Editor.
# 3. Isi kredensial di bawah (private key boleh pakai \n literal).
#
# Tanpa kredensial ini, form tetap dipakai asal tidak menyertakan file.
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@xxx.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Opsional: ID folder Drive (jika diisi, folder tidak dicari/dibuat)
# GOOGLE_DRIVE_FOLDER_ID=xxxxx
GOOGLE_DRIVE_FOLDER_NAME=doc_kunjungan
# Tautan bisa dibuka siapa pun yang punya link (default true)
# GOOGLE_DRIVE_PUBLIC_LINK=false

# Email tujuan dokumen surat tugas (sementara: gmail pribadi).
# Nanti cukup ganti ke email sekolah di sini — tidak perlu ubah kode.
SURAT_TUGAS_EMAIL=rubikesper@gmail.com

# CATATAN: AUTH_SECRET dan TOKEN_TTL_SECONDS tidak lagi dipakai.
# Login admin sekarang memakai Supabase Auth (GoTrue) — token & masa berlakunya
# diatur langsung oleh Supabase.
