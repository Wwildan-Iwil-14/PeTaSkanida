# ===== Backend PeTa SKANIDA =====

# Port server API
PORT=3001

# URL project Supabase (Settings > API)
SUPABASE_URL=https://xxxxx.supabase.co

# Service role key (Settings > API Keys > service_role)
# WAJIB untuk approve/reject request karena operasi tulis melewati RLS.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anon key, hanya dipakai sebagai fallback ketika service role key belum diisi
SUPABASE_ANON_KEY=your_anon_key_here

# Origin frontend yang diizinkan (pisahkan dengan koma)
# Tambahkan URL GitHub Pages saat backend dipasang di hosting publik.
CORS_ORIGIN=http://localhost:5173,https://petaskanida-collab.github.io

# CATATAN: AUTH_SECRET dan TOKEN_TTL_SECONDS tidak lagi dipakai.
# Login admin sekarang memakai Supabase Auth (GoTrue) — token & masa berlakunya
# diatur langsung oleh Supabase.
